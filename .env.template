# ── Supabase ──────────────────────────────────────────────────────────────────
# Free tier: 500 MB DB storage, unlimited API requests, 5 GB egress/month
# Projects pause after 1 week of inactivity (GitHub Actions heartbeat prevents this)
# Limit: 2 active projects on free plan
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# ── xAI / Grok ────────────────────────────────────────────────────────────────
# Advisor, weekly exploration, and the contextual layer. Model is grok-4.7
# (config.reasoning.model). Same key the shop Worker uses.
# Pricing (under 200k context): $2/MTok in + $6/MTok out.
GROK_API_KEY=

# ── Tavily MCP ────────────────────────────────────────────────────────────────
# Free tier: 1,000 API calls/month (resets 1st of each month)
# Each daily run uses up to TAVILY_MAX_SEARCHES (default 5) calls
# At 5 calls/run × 22 weekday runs/month = ~110 calls/month — well within free tier
TAVILY_MCP_URL=

# ── Alpha Vantage MCP ─────────────────────────────────────────────────────────
# Free tier: 25 calls/day, 5 calls/min
# MCP endpoint: https://mcp.alphavantage.co/mcp?apikey=YOUR_KEY
# Each daily run capped at ALPHA_VANTAGE_MAX_CALLS (default 8) to stay within daily limit
ALPHA_VANTAGE_API_KEY=

# ── SEC EDGAR MCP ──────────────────────────────────────────────────────────────
# Community-hosted endpoint (cyanheads/secedgar-mcp-server) — no API key required
# Tool: secedgar_get_insider_transactions (Form 3/4/5 insider activity)
# Rate limit: 10 req/sec; SEC fair-access policy requires a valid User-Agent (sent by MCP client)
# Note: community-hosted, not official — may go down; agent falls back gracefully if unavailable
# Override with SEC_EDGAR_MCP_URL if the endpoint changes
SEC_EDGAR_MCP_URL=https://secedgar.caseyjhand.com/mcp

# ── FMP MCP ────────────────────────────────────────────────────────────────────
# Financial Modeling Prep — analyst ratings, price targets, earnings calendar
# Free tier: 250 calls/day (resets daily)
# MCP endpoint: https://financialmodelingprep.com/mcp?apikey=YOUR_KEY
# Free plan limitation: analyst data (price-target-consensus, grades) only available
# for large/mid caps — small caps (RKLB, ASTS) gracefully return empty, no error
# Paid plans from $19/month unlock small-cap analyst coverage
FMP_API_KEY=

# ── Robinhood live portfolio sync ─────────────────────────────────────────────
# Primary (read-only) account number — shown in your Robinhood account settings
ROBINHOOD_ACCOUNT_NUMBER=
# AES-256 key used to decrypt tokens.enc (output from: bunx robinhood-for-agents onboard)
ROBINHOOD_TOKEN_KEY=
# Path to encrypted token file created by onboard (default: tokens.enc in project root)
ROBINHOOD_TOKENS_FILE=tokens.enc
# GitHub Actions: store base64(tokens.enc) as ROBINHOOD_TOKENS_ENC secret
# GitHub Actions: store ROBINHOOD_TOKEN_KEY and ROBINHOOD_ACCOUNT_NUMBER as secrets too
